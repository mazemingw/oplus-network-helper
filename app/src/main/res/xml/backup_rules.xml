<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="sharedpref" path="diagnostic-reporting.xml" />
    <exclude domain="sharedpref" path="efs-vault.xml" />
    <exclude domain="file" path="efs-cloud" />
    <exclude domain="file" path="feature-backups" />
    <exclude domain="file" path="initial-efs-backup.json" />
    <exclude domain="file" path="logs" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
